{
  "analysis": {
    "char_filter": {
      "html_strip_filter": {
        "type": "html_strip"
      }
    },
    "filter": {
      "synonym_filter": {
        "type": "synonym",
        "synonyms": [

        ]
      },
      "nori_readingform": {
        "type": "nori_readingform"
      }
    },
    "analyzer": {
      "korean_analyzer": {
        "type": "custom",
        "char_filter": ["html_strip_filter"],
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "nori_readingform"]
      },
      "name_analyzer": {
        "type": "custom",
        "char_filter": ["html_strip_filter"],
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "synonym_filter", "nori_readingform"]
      },
      "standard_lowercase": {
        "type": "custom",
        "char_filter": ["html_strip_filter"],
        "tokenizer": "standard",
        "filter": ["lowercase"]
      }
    }
  }
}